// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id   String  @id @default(cuid())
  name String
  slug String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  subscription     Subscription?
  billingProfile   BillingProfile?
  businessSettings BusinessSettings?
  agendaSettings   AgendaSettings?

  clients           Client[]
  clientTags        ClientTag[]
  serviceCategories ServiceCategory[]
  services          Service[]

  appointments         Appointment[]
  appointmentReminders AppointmentReminder[]
  sessions             Session[]

  products              Product[]
  productCategories     ProductCategory[]
  media                 Media[]
  consentDocuments      ConsentDocument[]
  financialTransactions FinancialTransaction[]
  recurringExpenses     RecurringExpense[]
  financialGoals        FinancialGoal[]
  financialSnapshots    FinancialSnapshot[]
  notifications         Notification[]
  messageTemplates      MessageTemplate[]
  messageLogs           MessageLog[]
  stockMovements        StockMovement[]

  @@index([slug])
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  fullName    String?
  avatarUrl   String?
  role        UserRole @default(OWNER)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings UserSettings?

  createdAppointments   Appointment[]              @relation("AppointmentCreatedBy")
  appointmentStatusLogs AppointmentStatusHistory[]
  clientNotes           ClientNote[]

  notificationPreference NotificationPreference?
  stockMovements         StockMovement[]
  notifications          Notification[]
}

model UserSettings {
  id                  String    @id @default(cuid())
  userId              String    @unique
  locale              String    @default("fr")
  timezone            String    @default("Europe/Paris")
  theme               ThemeMode @default(LIGHT)
  dashboardLayoutJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                     String          @id @default(cuid())
  tenantId               String          @unique
  provider               BillingProvider @default(STRIPE)
  providerCustomerId     String?         @unique
  providerSubscriptionId String?         @unique

  status             SubscriptionStatus @default(TRIALING)
  planName           String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BillingProfile {
  id       String @id @default(cuid())
  tenantId String @unique

  businessName String?
  legalStatus  String?
  billingEmail String?
  vatNumber    String?

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  displayName     String?
  logoUrl         String?
  primaryColor    String?
  defaultCurrency String  @default("EUR")
  bookingEnabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AgendaSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  workingDaysJson            Json?
  openingHoursJson           Json?
  defaultAppointmentDuration Int?
  bufferMin                  Int?  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Client {
  id       String @id @default(cuid())
  tenantId String

  firstName  String
  lastName   String?
  fullName   String?
  email      String?
  phone      String?
  instagram  String?
  birthDate  DateTime?
  referredBy String?

  isLoyal      Boolean   @default(false)
  firstVisitAt DateTime?
  lastVisitAt  DateTime?
  visitCount   Int       @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  notes          ClientNote[]
  allergies      ClientAllergy[]
  tagAssignments ClientTagAssignment[]
  appointments   Appointment[]
  sessions       Session[]

  clientMedia      ClientMedia[]
  consentDocuments ConsentDocument[]
  notifications    Notification[]
  messageLogs      MessageLog[]

  @@index([tenantId])
  @@index([tenantId, firstName])
  @@index([tenantId, lastName])
  @@index([tenantId, archivedAt])
}

model ClientNote {
  id              String  @id @default(cuid())
  clientId        String
  createdByUserId String?

  type     ClientNoteType @default(GENERAL)
  title    String?
  content  String
  isPinned Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client        Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdByUserId])
}

model ClientAllergy {
  id       String @id @default(cuid())
  clientId String

  label    String
  severity AllergySeverity?
  notes    String?
  isActive Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientTag {
  id       String @id @default(cuid())
  tenantId String

  name  String
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ClientTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ClientTagAssignment {
  id          String @id @default(cuid())
  clientId    String
  clientTagId String

  createdAt DateTime @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientTag ClientTag @relation(fields: [clientTagId], references: [id], onDelete: Cascade)

  @@unique([clientId, clientTagId])
  @@index([clientId])
  @@index([clientTagId])
}

model ServiceCategory {
  id       String @id @default(cuid())
  tenantId String

  name      String
  slug      String?
  color     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Service {
  id                String  @id @default(cuid())
  tenantId          String
  serviceCategoryId String?

  name        String
  slug        String?
  durationMin Int?
  price       Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)

  appointments Appointment[]
  sessions     Session[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([serviceCategoryId])
}

model Appointment {
  id              String  @id @default(cuid())
  tenantId        String
  clientId        String
  serviceId       String?
  createdByUserId String?

  scheduledAt DateTime
  endAt       DateTime?

  status        AppointmentStatus @default(SCHEDULED)
  paymentStatus PaymentStatus     @default(PENDING)
  source        AppointmentSource @default(MANUAL)

  notes   String?
  isDraft Boolean @default(false)

  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdByUser User?    @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  statusHistory AppointmentStatusHistory[]
  reminders     AppointmentReminder[]
  attachments   AppointmentAttachment[]
  session       Session?

  consentDocuments      ConsentDocument[]
  notifications         Notification[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId])
  @@index([clientId])
  @@index([serviceId])
  @@index([createdByUserId])
  @@index([scheduledAt])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, status])
}

model AppointmentStatusHistory {
  id              String  @id @default(cuid())
  appointmentId   String
  changedByUserId String?

  oldStatus AppointmentStatus?
  newStatus AppointmentStatus
  reason    String?

  createdAt DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedByUser User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([changedByUserId])
}

model AppointmentReminder {
  id            String @id @default(cuid())
  tenantId      String
  appointmentId String

  channel      ReminderChannel
  status       ReminderStatus  @default(PENDING)
  scheduledFor DateTime
  sentAt       DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
  @@index([scheduledFor])
}

model AppointmentAttachment {
  id            String @id @default(cuid())
  appointmentId String

  name      String
  url       String
  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Session {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  tenantId      String
  clientId      String
  serviceId     String?

  category SessionCategory
  status   SessionStatus   @default(DRAFT)

  startedAt DateTime?
  endedAt   DateTime?

  title         String?
  generalNotes  String?
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  lashSession     LashSession?
  browliftSession BrowliftSession?
  lashLiftSession LashLiftSession?
  nailSession     NailSession?

  sessionComments SessionComment[]

  sessionMedia          SessionMedia[]
  productUsages         SessionProductUsage[]
  stockMovements        StockMovement[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId])
  @@index([clientId])
  @@index([serviceId])
  @@index([tenantId, status])
  @@index([tenantId, category])
}

model SessionComment {
  id        String @id @default(cuid())
  sessionId String

  content  String
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model LashSession {
  id        String @id @default(cuid())
  sessionId String @unique

  prestationType String?
  poseName       String?

  lashBrand     String?
  lashReference String?
  glueUsed      String?

  generalCurl          String?
  generalThickness     String?
  generalLengthMapJson Json?
  globalParamsJson     Json?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eyeConfigs LashEyeConfig[]

  @@index([sessionId])
}

model LashEyeConfig {
  id            String  @id @default(cuid())
  lashSessionId String
  side          EyeSide

  curl          String?
  thickness     String?
  lengthMapJson Json?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lashSession LashSession @relation(fields: [lashSessionId], references: [id], onDelete: Cascade)

  @@unique([lashSessionId, side])
  @@index([lashSessionId])
}

model BrowliftSession {
  id        String @id @default(cuid())
  sessionId String @unique

  tintEnabled      Boolean @default(false)
  tintColor        String?
  globalParamsJson Json?
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pauseSteps BrowliftPauseStep[]

  @@index([sessionId])
}

model BrowliftPauseStep {
  id                String @id @default(cuid())
  browliftSessionId String

  stepOrder   Int
  label       String
  durationMin Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  browliftSession BrowliftSession @relation(fields: [browliftSessionId], references: [id], onDelete: Cascade)

  @@unique([browliftSessionId, stepOrder])
  @@index([browliftSessionId])
}

model LashLiftSession {
  id        String @id @default(cuid())
  sessionId String @unique

  tintEnabled      Boolean @default(false)
  tintColor        String?
  globalParamsJson Json?
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pauseSteps LashLiftPauseStep[]
  eyeConfigs LashLiftEyeConfig[]

  @@index([sessionId])
}

model LashLiftPauseStep {
  id                String @id @default(cuid())
  lashLiftSessionId String

  stepOrder   Int
  label       String
  durationMin Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lashLiftSession LashLiftSession @relation(fields: [lashLiftSessionId], references: [id], onDelete: Cascade)

  @@unique([lashLiftSessionId, stepOrder])
  @@index([lashLiftSessionId])
}

model LashLiftEyeConfig {
  id                String  @id @default(cuid())
  lashLiftSessionId String
  side              EyeSide

  padSize String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lashLiftSession LashLiftSession @relation(fields: [lashLiftSessionId], references: [id], onDelete: Cascade)

  @@unique([lashLiftSessionId, side])
  @@index([lashLiftSessionId])
}

model NailSession {
  id        String @id @default(cuid())
  sessionId String @unique

  prestationType String?
  poseType       String?
  shape          String?
  size           String?

  baseUsed   String?
  gelUsed    String?
  colorUsed  String?
  primerUsed String?

  globalParamsJson Json?
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  handConfigs NailHandConfig[]

  @@index([sessionId])
}

model NailHandConfig {
  id            String   @id @default(cuid())
  nailSessionId String
  side          HandSide

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nailSession   NailSession        @relation(fields: [nailSessionId], references: [id], onDelete: Cascade)
  fingerConfigs NailFingerConfig[]

  @@unique([nailSessionId, side])
  @@index([nailSessionId])
}

model NailFingerConfig {
  id               String     @id @default(cuid())
  nailHandConfigId String
  finger           FingerName

  capsuleSize String?
  length      String?
  shape       String?
  color       String?
  design      String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nailHandConfig NailHandConfig @relation(fields: [nailHandConfigId], references: [id], onDelete: Cascade)

  @@unique([nailHandConfigId, finger])
  @@index([nailHandConfigId])
}

enum SessionCategory {
  LASHES
  BROWLIFT
  LASH_LIFT
  NAILS
}

enum SessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum EyeSide {
  LEFT
  RIGHT
}

enum HandSide {
  LEFT
  RIGHT
}

enum FingerName {
  THUMB
  INDEX
  MIDDLE
  RING
  LITTLE
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum BillingProvider {
  STRIPE
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  PAUSED
}

enum ClientNoteType {
  GENERAL
  ALLERGY
  PREFERENCE
  BEHAVIOR
  INTERNAL
}

enum AllergySeverity {
  LOW
  MEDIUM
  HIGH
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  UNPAID
  REFUNDED
}

enum AppointmentSource {
  MANUAL
  ONLINE_BOOKING
  IMPORTED
}

enum ReminderChannel {
  EMAIL
  PUSH
  SMS
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model ProductCategory {
  id       String @id @default(cuid())
  tenantId String

  name      String
  slug      String?
  color     String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id                String  @id @default(cuid())
  tenantId          String
  productCategoryId String?

  name      String
  brand     String?
  reference String?

  unitType     ProductUnitType     @default(UNIT)
  trackingType ProductTrackingType @default(UNIDOSE)

  defaultUnitCost Decimal? @db.Decimal(10, 2)
  alertThreshold  Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productCategory ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)

  lots           ProductLot[]
  stockMovements StockMovement[]
  sessionUsages  SessionProductUsage[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([productCategoryId])
}

model ProductLot {
  id        String @id @default(cuid())
  productId String

  lotNumber String?
  openedAt  DateTime?
  expiresAt DateTime?

  quantityInitial   Decimal? @db.Decimal(10, 3)
  quantityRemaining Decimal? @db.Decimal(10, 3)

  status ProductLotStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  sessionUsages  SessionProductUsage[]

  @@index([productId])
  @@index([expiresAt])
  @@index([status])
}

model StockMovement {
  id              String  @id @default(cuid())
  tenantId        String
  productId       String
  productLotId    String?
  sessionId       String?
  createdByUserId String?

  type     StockMovementType
  quantity Decimal           @db.Decimal(10, 3)
  reason   String?
  notes    String?

  createdAt DateTime @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productLot    ProductLot? @relation(fields: [productLotId], references: [id], onDelete: SetNull)
  session       Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdByUser User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@index([productLotId])
  @@index([sessionId])
  @@index([createdByUserId])
  @@index([tenantId, createdAt])
}

model SessionProductUsage {
  id           String  @id @default(cuid())
  sessionId    String
  productId    String
  productLotId String?

  usageRole    String?
  quantityUsed Decimal? @db.Decimal(10, 3)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productLot ProductLot? @relation(fields: [productLotId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([productId])
  @@index([productLotId])
}

model Media {
  id       String @id @default(cuid())
  tenantId String

  url        String
  storageKey String?
  mimeType   String?
  width      Int?
  height     Int?
  sizeBytes  Int?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientLinks  ClientMedia[]
  sessionLinks SessionMedia[]

  @@index([tenantId])
}

model ClientMedia {
  id       String @id @default(cuid())
  clientId String
  mediaId  String

  label     String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([clientId, mediaId])
  @@index([clientId])
  @@index([mediaId])
}

model SessionMedia {
  id        String @id @default(cuid())
  sessionId String
  mediaId   String

  label     String?
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([sessionId, mediaId])
  @@index([sessionId])
  @@index([mediaId])
}

model ConsentDocument {
  id            String  @id @default(cuid())
  tenantId      String
  clientId      String
  appointmentId String?

  documentType ConsentDocumentType
  pdfUrl       String
  signedAt     DateTime?
  expiresAt    DateTime?

  snapshotJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientId])
  @@index([appointmentId])
}

model FinancialTransaction {
  id            String  @id @default(cuid())
  tenantId      String
  appointmentId String?
  sessionId     String?

  type       FinancialTransactionType
  sourceType FinancialSourceType

  label         String
  amount        Decimal                 @db.Decimal(10, 2)
  currency      String                  @default("EUR")
  paymentMethod FinancialPaymentMethod?

  category        String?
  transactionDate DateTime
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([appointmentId])
  @@index([sessionId])
  @@index([transactionDate])
  @@index([tenantId, transactionDate])
  @@index([tenantId, type])
}

model RecurringExpense {
  id       String @id @default(cuid())
  tenantId String

  label    String
  category String?
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("EUR")

  frequency RecurringExpenseFrequency
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean                   @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model FinancialGoal {
  id       String @id @default(cuid())
  tenantId String @unique

  monthlyNetGoal     Decimal? @db.Decimal(10, 2)
  monthlyRevenueGoal Decimal? @db.Decimal(10, 2)
  monthlyFixedCosts  Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FinancialSnapshot {
  id       String @id @default(cuid())
  tenantId String

  periodType  FinancialSnapshotPeriodType
  periodStart DateTime
  periodEnd   DateTime

  revenue  Decimal @db.Decimal(10, 2)
  expenses Decimal @db.Decimal(10, 2)
  profit   Decimal @db.Decimal(10, 2)

  appointmentCount Int      @default(0)
  averageBasket    Decimal? @db.Decimal(10, 2)
  newClientsCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodType, periodStart, periodEnd])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  appointmentReminderEnabled Boolean @default(true)
  stockAlertEnabled          Boolean @default(true)
  marketingInsightEnabled    Boolean @default(true)
  emailEnabled               Boolean @default(true)
  pushEnabled                Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String  @id @default(cuid())
  tenantId      String
  userId        String?
  clientId      String?
  appointmentId String?

  type   NotificationType
  title  String
  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([createdAt])
}

model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String

  type          MessageTemplateType
  name          String
  subject       String?
  body          String
  variablesJson Json?
  isActive      Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageLogs MessageLog[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model MessageLog {
  id         String  @id @default(cuid())
  tenantId   String
  clientId   String?
  templateId String?

  channel MessageChannel
  subject String?
  body    String
  status  MessageLogStatus @default(PENDING)
  sentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientId])
  @@index([templateId])
  @@index([sentAt])
}

