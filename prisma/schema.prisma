generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AgendaSettings {
  id                         String      @id
  tenantId                   String      @unique
  workingDaysJson            Json?
  openingHoursJson           Json?
  defaultAppointmentDuration Int?
  bufferMin                  Int?        @default(0)
  minBookingNoticeMin        Int         @default(1440)
  slotIntervalMin            Int         @default(30)
  depositsEnabled            Boolean     @default(false)
  depositsRequired           Boolean     @default(false)
  depositAmount              Int         @default(0)
  depositType                DepositType @default(fixed)
  pendingBookingTtlMin       Int         @default(15)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime
  Tenant                     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                       String                     @id
  tenantId                 String
  clientId                 String
  serviceId                String?
  createdByUserId          String?
  scheduledAt              DateTime
  endAt                    DateTime?
  status                   AppointmentStatus          @default(SCHEDULED)
  paymentStatus            PaymentStatus              @default(none)
  price                    Int?
  depositAmount            Int?
  depositPaidAmount        Int                        @default(0)
  paidAmount               Int                        @default(0)
  remainingAmount          Int                        @default(0)
  paymentMethod            AppointmentPaymentMethod?
  stripeCheckoutSessionId  String?
  stripePaymentIntentId    String?
  source                   AppointmentSource          @default(MANUAL)
  notes                    String?
  isDraft                  Boolean                    @default(false)
  cancelledAt              DateTime?
  completedAt              DateTime?
  expiresAt                DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  Client                   Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User                     User?                      @relation(fields: [createdByUserId], references: [id])
  Service                  Service?                   @relation(fields: [serviceId], references: [id])
  Tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  AppointmentAttachment    AppointmentAttachment[]
  AppointmentReminder      AppointmentReminder[]
  AppointmentReminderLog   AppointmentReminderLog[]
  AppointmentStatusHistory AppointmentStatusHistory[]
  ConsentDocument          ConsentDocument[]
  FinancialTransaction     FinancialTransaction[]
  Notification             Notification[]
  Session                  Session?

  @@index([clientId])
  @@index([createdByUserId])
  @@index([scheduledAt])
  @@index([serviceId])
  @@index([tenantId])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
}

model AvailabilityException {
  id        String                    @id
  tenantId  String
  type      AvailabilityExceptionType @default(OTHER)
  title     String?
  startAt   DateTime
  endAt     DateTime
  allDay    Boolean                   @default(false)
  notes     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime
  Tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startAt, endAt])
}

model AppointmentAttachment {
  id            String      @id
  appointmentId String
  name          String
  url           String
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime    @default(now())
  Appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AppointmentReminder {
  id            String          @id
  tenantId      String
  appointmentId String
  channel       ReminderChannel
  status        ReminderStatus  @default(PENDING)
  scheduledFor  DateTime
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  Tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([scheduledFor])
  @@index([tenantId])
}

model AppointmentReminderLog {
  id               String           @id
  tenantId         String
  appointmentId    String
  clientId         String?
  type             ReminderLogType
  channel          MessageChannel   @default(SMS)
  status           MessageLogStatus @default(PENDING)
  twilioMessageSid String?
  errorMessage     String?
  sentAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  Appointment      Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  Client           Client?          @relation(fields: [clientId], references: [id])
  Tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, type])
  @@index([clientId])
  @@index([sentAt])
  @@index([tenantId])
  @@index([type, status])
}

model AppointmentStatusHistory {
  id              String             @id
  appointmentId   String
  changedByUserId String?
  oldStatus       AppointmentStatus?
  newStatus       AppointmentStatus
  reason          String?
  createdAt       DateTime           @default(now())
  Appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  User            User?              @relation(fields: [changedByUserId], references: [id])

  @@index([appointmentId])
  @@index([changedByUserId])
}

model BillingProfile {
  id           String   @id
  tenantId     String   @unique
  businessName String?
  legalStatus  String?
  billingEmail String?
  vatNumber    String?
  siret        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BrowliftPauseStep {
  id                String          @id
  browliftSessionId String
  stepOrder         Int
  label             String
  durationMin       Int?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  BrowliftSession   BrowliftSession @relation(fields: [browliftSessionId], references: [id], onDelete: Cascade)

  @@unique([browliftSessionId, stepOrder])
  @@index([browliftSessionId])
}

model BrowliftSession {
  id                String              @id
  sessionId         String              @unique
  tintEnabled       Boolean             @default(false)
  tintColor         String?
  globalParamsJson  Json?
  remarks           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  BrowliftPauseStep BrowliftPauseStep[]
  Session           Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model BusinessSettings {
  id                    String   @id
  tenantId              String   @unique
  displayName           String?
  logoUrl               String?
  primaryColor          String?
  defaultCurrency       String   @default("EUR")
  bookingEnabled        Boolean  @default(false)
  smsRemindersEnabled   Boolean  @default(false)
  smsReminderDelayHours Int      @default(24)
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  Tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Client {
  id                     String                   @id
  tenantId               String
  firstName              String
  lastName               String?
  fullName               String?
  email                  String?
  phone                  String?
  instagram              String?
  birthDate              DateTime?
  referredBy             String?
  isLoyal                Boolean                  @default(false)
  firstVisitAt           DateTime?
  lastVisitAt            DateTime?
  visitCount             Int                      @default(0)
  archivedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  Appointment            Appointment[]
  CampaignRecipientLog   CampaignRecipientLog[]
  Tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ClientAllergy          ClientAllergy[]
  ClientMedia            ClientMedia[]
  ClientNote             ClientNote[]
  ClientTagAssignment    ClientTagAssignment[]
  ConsentDocument        ConsentDocument[]
  AppointmentReminderLog AppointmentReminderLog[]
  MessageLog             MessageLog[]
  Notification           Notification[]
  Session                Session[]

  @@index([tenantId, archivedAt])
  @@index([tenantId, firstName])
  @@index([tenantId])
  @@index([tenantId, lastName])
}

model Campaign {
  id                   String                 @id
  tenantId             String
  templateId           String?
  name                 String
  targetSegment        CampaignTargetSegment
  channel              CampaignChannel
  customMessage        String?
  status               CampaignStatus         @default(DRAFT)
  recipientsCount      Int                    @default(0)
  sentCount            Int                    @default(0)
  failedCount          Int                    @default(0)
  skippedCount         Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  sentAt               DateTime?
  CampaignRecipientLog CampaignRecipientLog[]
  MessageTemplate      MessageTemplate?       @relation(fields: [templateId], references: [id])
  Tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([templateId])
}

model CampaignRecipientLog {
  id           String                  @id
  campaignId   String
  tenantId     String
  clientId     String?
  channel      CampaignChannel
  status       CampaignRecipientStatus
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime
  Campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  Client       Client?                 @relation(fields: [clientId], references: [id])
  Tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([clientId])
  @@index([tenantId])
  @@index([tenantId, status])
}

model ClientAllergy {
  id        String           @id
  clientId  String
  label     String
  severity  AllergySeverity?
  notes     String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime
  Client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientMedia {
  id        String   @id
  clientId  String
  mediaId   String
  label     String?
  createdAt DateTime @default(now())
  Client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([clientId, mediaId])
  @@index([clientId])
  @@index([mediaId])
}

model ClientNote {
  id              String         @id
  clientId        String
  createdByUserId String?
  type            ClientNoteType @default(GENERAL)
  title           String?
  content         String
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User            User?          @relation(fields: [createdByUserId], references: [id])

  @@index([clientId])
  @@index([createdByUserId])
}

model ClientTag {
  id                  String                @id
  tenantId            String
  name                String
  color               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ClientTagAssignment ClientTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ClientTagAssignment {
  id          String    @id
  clientId    String
  clientTagId String
  createdAt   DateTime  @default(now())
  Client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ClientTag   ClientTag @relation(fields: [clientTagId], references: [id], onDelete: Cascade)

  @@unique([clientId, clientTagId])
  @@index([clientId])
  @@index([clientTagId])
}

model ConsentDocument {
  id            String              @id
  tenantId      String
  clientId      String
  appointmentId String?
  documentType  ConsentDocumentType
  pdfUrl        String
  signedAt      DateTime?
  expiresAt     DateTime?
  snapshotJson  Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  Client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([clientId])
  @@index([tenantId])
}

model FinancialGoal {
  id                 String   @id
  tenantId           String   @unique
  monthlyNetGoal     Decimal? @db.Decimal(10, 2)
  monthlyRevenueGoal Decimal? @db.Decimal(10, 2)
  monthlyFixedCosts  Decimal? @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  Tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FinancialSnapshot {
  id               String                      @id
  tenantId         String
  periodType       FinancialSnapshotPeriodType
  periodStart      DateTime
  periodEnd        DateTime
  revenue          Decimal                     @db.Decimal(10, 2)
  expenses         Decimal                     @db.Decimal(10, 2)
  profit           Decimal                     @db.Decimal(10, 2)
  appointmentCount Int                         @default(0)
  averageBasket    Decimal?                    @db.Decimal(10, 2)
  newClientsCount  Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime
  Tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodType, periodStart, periodEnd])
  @@index([tenantId])
  @@index([tenantId, periodStart, periodEnd])
}

model FinancialTransaction {
  id                String                   @id
  tenantId          String
  appointmentId     String?
  sessionId         String?
  externalPaymentId String?                  @unique
  type              FinancialTransactionType
  sourceType        FinancialSourceType
  label             String
  amount            Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("EUR")
  paymentMethod     FinancialPaymentMethod?
  category          String?
  transactionDate   DateTime
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime
  Appointment       Appointment?             @relation(fields: [appointmentId], references: [id])
  Session           Session?                 @relation(fields: [sessionId], references: [id])
  Tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([sessionId])
  @@index([tenantId])
  @@index([tenantId, transactionDate])
  @@index([tenantId, type])
  @@index([transactionDate])
}

model LashEyeConfig {
  id            String      @id
  lashSessionId String
  side          EyeSide
  curl          String?
  thickness     String?
  lengthMapJson Json?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  LashSession   LashSession @relation(fields: [lashSessionId], references: [id], onDelete: Cascade)

  @@unique([lashSessionId, side])
  @@index([lashSessionId])
}

model LashLiftEyeConfig {
  id                String          @id
  lashLiftSessionId String
  side              EyeSide
  padSize           String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  LashLiftSession   LashLiftSession @relation(fields: [lashLiftSessionId], references: [id], onDelete: Cascade)

  @@unique([lashLiftSessionId, side])
  @@index([lashLiftSessionId])
}

model LashLiftPauseStep {
  id                String          @id
  lashLiftSessionId String
  stepOrder         Int
  label             String
  durationMin       Int?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  LashLiftSession   LashLiftSession @relation(fields: [lashLiftSessionId], references: [id], onDelete: Cascade)

  @@unique([lashLiftSessionId, stepOrder])
  @@index([lashLiftSessionId])
}

model LashLiftSession {
  id                String              @id
  sessionId         String              @unique
  tintEnabled       Boolean             @default(false)
  tintColor         String?
  globalParamsJson  Json?
  remarks           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  LashLiftEyeConfig LashLiftEyeConfig[]
  LashLiftPauseStep LashLiftPauseStep[]
  Session           Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model LashSession {
  id                   String          @id
  sessionId            String          @unique
  prestationType       String?
  poseName             String?
  lashBrand            String?
  lashReference        String?
  glueUsed             String?
  generalCurl          String?
  generalThickness     String?
  generalLengthMapJson Json?
  globalParamsJson     Json?
  remarks              String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  LashEyeConfig        LashEyeConfig[]
  Session              Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Media {
  id           String         @id
  tenantId     String
  url          String
  storageKey   String?
  mimeType     String?
  width        Int?
  height       Int?
  sizeBytes    Int?
  createdAt    DateTime       @default(now())
  ClientMedia  ClientMedia[]
  Tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  SessionMedia SessionMedia[]

  @@index([tenantId])
}

model GalleryImage {
  id        String   @id
  tenantId  String
  imageUrl  String
  alt       String?
  sortOrder Int      @default(0)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isPublic])
  @@index([tenantId, sortOrder])
}

model MessageLog {
  id              String           @id
  tenantId        String
  clientId        String?
  templateId      String?
  channel         MessageChannel
  subject         String?
  body            String
  status          MessageLogStatus @default(PENDING)
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  Client          Client?          @relation(fields: [clientId], references: [id])
  MessageTemplate MessageTemplate? @relation(fields: [templateId], references: [id])
  Tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sentAt])
  @@index([templateId])
  @@index([tenantId])
}

model MessageTemplate {
  id            String              @id
  tenantId      String
  type          MessageTemplateType
  channel       MessageChannel      @default(SMS)
  name          String
  subject       String?
  body          String
  variablesJson Json?
  isActive      Boolean             @default(true)
  isSystem      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Campaign      Campaign[]
  MessageLog    MessageLog[]
  Tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model NailFingerConfig {
  id               String         @id
  nailHandConfigId String
  finger           FingerName
  capsuleSize      String?
  length           String?
  shape            String?
  color            String?
  design           String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  NailHandConfig   NailHandConfig @relation(fields: [nailHandConfigId], references: [id], onDelete: Cascade)

  @@unique([nailHandConfigId, finger])
  @@index([nailHandConfigId])
}

model NailHandConfig {
  id               String             @id
  nailSessionId    String
  side             HandSide
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  NailFingerConfig NailFingerConfig[]
  NailSession      NailSession        @relation(fields: [nailSessionId], references: [id], onDelete: Cascade)

  @@unique([nailSessionId, side])
  @@index([nailSessionId])
}

model NailSession {
  id               String           @id
  sessionId        String           @unique
  prestationType   String?
  poseType         String?
  shape            String?
  size             String?
  baseUsed         String?
  gelUsed          String?
  colorUsed        String?
  primerUsed       String?
  globalParamsJson Json?
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  NailHandConfig   NailHandConfig[]
  Session          Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Notification {
  id            String           @id
  tenantId      String
  userId        String?
  clientId      String?
  appointmentId String?
  type          NotificationType
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  Appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  Client        Client?          @relation(fields: [clientId], references: [id])
  Tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User          User?            @relation(fields: [userId], references: [id])

  @@index([appointmentId])
  @@index([clientId])
  @@index([createdAt])
  @@index([tenantId])
  @@index([userId])
}

model NotificationPreference {
  id                         String   @id
  userId                     String   @unique
  appointmentReminderEnabled Boolean  @default(true)
  stockAlertEnabled          Boolean  @default(true)
  marketingInsightEnabled    Boolean  @default(true)
  emailEnabled               Boolean  @default(true)
  pushEnabled                Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime
  User                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                  String                @id
  tenantId            String
  productCategoryId   String?
  name                String
  brand               String?
  reference           String?
  unitType            ProductUnitType       @default(UNIT)
  trackingType        ProductTrackingType   @default(UNIDOSE)
  defaultUnitCost     Decimal?              @db.Decimal(10, 2)
  alertThreshold      Decimal?              @db.Decimal(10, 2)
  isActive            Boolean               @default(true)
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  ProductCategory     ProductCategory?      @relation(fields: [productCategoryId], references: [id])
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ProductLot          ProductLot[]
  SessionProductUsage SessionProductUsage[]
  StockMovement       StockMovement[]

  @@unique([tenantId, name])
  @@index([productCategoryId])
  @@index([tenantId])
}

model ProductCategory {
  id        String    @id
  tenantId  String
  name      String
  slug      String?
  color     String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Product   Product[]
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductLot {
  id                  String                @id
  productId           String
  lotNumber           String?
  openedAt            DateTime?
  expiresAt           DateTime?
  quantityInitial     Decimal?              @db.Decimal(10, 3)
  quantityRemaining   Decimal?              @db.Decimal(10, 3)
  status              ProductLotStatus      @default(ACTIVE)
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  SessionProductUsage SessionProductUsage[]
  StockMovement       StockMovement[]

  @@index([expiresAt])
  @@index([productId])
  @@index([status])
}

model PublicProfile {
  id            String   @id
  tenantId      String   @unique
  slug          String   @unique
  isPublished   Boolean  @default(false)
  businessName  String?
  ownerName     String?
  description   String?
  address       String?
  city          String?
  phone         String?
  email         String?
  instagramUrl  String?
  websiteUrl    String?
  openingHours  String?
  coverImageUrl String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([tenantId, isPublished])
}

model RecurringExpense {
  id        String                    @id
  tenantId  String
  label     String
  category  String?
  amount    Decimal                   @db.Decimal(10, 2)
  currency  String                    @default("EUR")
  frequency RecurringExpenseFrequency
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean                   @default(true)
  notes     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime
  Tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Review {
  id         String   @id
  tenantId   String
  authorName String
  rating     Int
  comment    String
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isVisible])
  @@index([tenantId, createdAt])
}

model Service {
  id                String           @id
  tenantId          String
  serviceCategoryId String?
  name              String
  slug              String?
  description       String?
  durationMin       Int?
  price             Decimal?         @db.Decimal(10, 2)
  category          String?
  imageUrl          String?
  isPublic          Boolean          @default(true)
  isActive          Boolean          @default(true)
  color             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  Appointment       Appointment[]
  ServiceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  Tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Session           Session[]

  @@unique([tenantId, name])
  @@index([serviceCategoryId])
  @@index([tenantId])
  @@index([tenantId, isPublic])
}

model ServiceCategory {
  id        String    @id
  tenantId  String
  name      String
  slug      String?
  color     String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Service   Service[]
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Session {
  id                   String                 @id
  appointmentId        String                 @unique
  tenantId             String
  clientId             String
  serviceId            String?
  category             SessionCategory
  status               SessionStatus          @default(DRAFT)
  startedAt            DateTime?
  endedAt              DateTime?
  title                String?
  generalNotes         String?
  internalNotes        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  BrowliftSession      BrowliftSession?
  FinancialTransaction FinancialTransaction[]
  LashLiftSession      LashLiftSession?
  LashSession          LashSession?
  NailSession          NailSession?
  Appointment          Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  Client               Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Service              Service?               @relation(fields: [serviceId], references: [id])
  Tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  SessionComment       SessionComment[]
  SessionMedia         SessionMedia[]
  SessionProductUsage  SessionProductUsage[]
  StockMovement        StockMovement[]

  @@index([clientId])
  @@index([serviceId])
  @@index([tenantId, category])
  @@index([tenantId])
  @@index([tenantId, status])
}

model SessionComment {
  id        String   @id
  sessionId String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model SessionMedia {
  id        String   @id
  sessionId String
  mediaId   String
  label     String?
  createdAt DateTime @default(now())
  Media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  Session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, mediaId])
  @@index([mediaId])
  @@index([sessionId])
}

model SessionProductUsage {
  id           String      @id
  sessionId    String
  productId    String
  productLotId String?
  usageRole    String?
  quantityUsed Decimal?    @db.Decimal(10, 3)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  Product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ProductLot   ProductLot? @relation(fields: [productLotId], references: [id])
  Session      Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productLotId])
  @@index([sessionId])
}

model StockMovement {
  id              String            @id
  tenantId        String
  productId       String
  productLotId    String?
  sessionId       String?
  createdByUserId String?
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 3)
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  User            User?             @relation(fields: [createdByUserId], references: [id])
  Product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  ProductLot      ProductLot?       @relation(fields: [productLotId], references: [id])
  Session         Session?          @relation(fields: [sessionId], references: [id])
  Tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
  @@index([productId])
  @@index([productLotId])
  @@index([sessionId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
}

model Subscription {
  id                     String             @id
  tenantId               String             @unique
  provider               BillingProvider    @default(STRIPE)
  providerCustomerId     String?            @unique
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(TRIALING)
  planName               String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  Tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Tenant {
  id                     String                   @id
  name                   String
  slug                   String?                  @unique
  subscriptionPlan       SubscriptionPlan         @default(FREE)
  subscriptionStatus     SubscriptionStatus       @default(TRIALING)
  trialEndsAt            DateTime?
  stripeCustomerId       String?                  @unique
  stripeSubscriptionId   String?                  @unique
  stripePriceId          String?
  onboardingDismissedAt  DateTime?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  AgendaSettings         AgendaSettings?
  AvailabilityException  AvailabilityException[]
  Appointment            Appointment[]
  AppointmentReminder    AppointmentReminder[]
  AppointmentReminderLog AppointmentReminderLog[]
  BillingProfile         BillingProfile?
  BusinessSettings       BusinessSettings?
  Client                 Client[]
  ClientTag              ClientTag[]
  ConsentDocument        ConsentDocument[]
  FinancialGoal          FinancialGoal?
  FinancialSnapshot      FinancialSnapshot[]
  FinancialTransaction   FinancialTransaction[]
  GalleryImage           GalleryImage[]
  Media                  Media[]
  PublicProfile          PublicProfile?
  Campaign               Campaign[]
  CampaignRecipientLog   CampaignRecipientLog[]
  MessageLog             MessageLog[]
  MessageTemplate        MessageTemplate[]
  Notification           Notification[]
  Product                Product[]
  ProductCategory        ProductCategory[]
  RecurringExpense       RecurringExpense[]
  Review                 Review[]
  Service                Service[]
  ServiceCategory        ServiceCategory[]
  Session                Session[]
  StockMovement          StockMovement[]
  Subscription           Subscription?
  User                   User[]

  @@index([slug])
}

model User {
  id                       String                     @id
  clerkUserId              String                     @unique
  email                    String                     @unique
  firstName                String?
  lastName                 String?
  fullName                 String?
  phone                    String?
  avatarUrl                String?
  role                     UserRole                   @default(OWNER)
  tenantId                 String
  stripeAccountId          String?
  stripeOnboardingComplete Boolean                    @default(false)
  paymentsEnabled          Boolean                    @default(false)
  defaultDepositAmount     Int                        @default(0)
  defaultDepositType       DepositType                @default(fixed)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  Appointment              Appointment[]
  AppointmentStatusHistory AppointmentStatusHistory[]
  ClientNote               ClientNote[]
  Notification             Notification[]
  NotificationPreference   NotificationPreference?
  StockMovement            StockMovement[]
  Tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  UserSettings             UserSettings?
}

model UserSettings {
  id                  String    @id
  userId              String    @unique
  locale              String    @default("fr")
  timezone            String    @default("Europe/Paris")
  theme               ThemeMode @default(LIGHT)
  dashboardLayoutJson Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

